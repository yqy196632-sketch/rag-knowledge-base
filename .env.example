# DeepSeek API Key（必填）。前往 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=sk-你的密钥

# 模型下载镜像（大陆网络首次拉 bge 模型必需，避免直连 huggingface.co 超时）
HF_ENDPOINT=https://hf-mirror.com

# 可选：切换模型
#   deepseek-flash    —— 默认，DeepSeek-V4.1-Flash，1M 上下文，快、便宜、支持工具调用与流式
#   deepseek-v4-pro   —— 强推理，价格更高，复杂任务再换
DEEPSEEK_MODEL=deepseek-flash
# 思考模式：disabled（默认，RAG 只基于上下文作答，更快更省）/ enabled
DEEPSEEK_THINKING=disabled

# 向量库持久化目录
CHROMA_PERSIST_DIR=./chroma_db

# 向量库集合名（入库端与问答端共用同一配置，由 app/services/vectorstore.py 统一读取）
COLLECTION_NAME=rag_knowledge_base

# 检索质量：Chroma 返回 L2 距离（越小越相关），超过阈值的块直接丢弃；

SIMILARITY_THRESHOLD=1.15

# LLM 网络容错（ChatDeepSeek 的字段是 request_timeout，不是 timeout）
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# 可选：覆盖默认 Embedding 模型（必须与入库、问答两端一致！）
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
